{
  "name": "openclaw-plugin-predictive-gating",
  "version": "0.2.0",
  "description": "Explainable, fail-safe context update policy engine for OpenClaw.",
  "type": "module",
  "types": "./dist/src/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "openclaw.plugin.json",
    "skills",
    "fixtures",
    "docs",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "evaluate": "npm run build && node dist/scripts/evaluate.js --fixtures fixtures --out evaluation-output",
    "public-boundary": "node scripts/check-public-boundary.mjs",
    "check": "npm run public-boundary && npm test && npm run evaluate"
  },
  "openclaw": {
    "extensions": [
      "./dist/src/index.js"
    ],
    "install": {
      "minHostVersion": ">=2026.5.27"
    },
    "compat": {
      "pluginApi": ">=2026.5.27"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhaoyeyu/ContextGate.git"
  },
  "bugs": {
    "url": "https://github.com/zhaoyeyu/ContextGate/issues"
  },
  "homepage": "https://github.com/zhaoyeyu/ContextGate#readme",
  "keywords": [
    "openclaw",
    "context-engine",
    "context-policy",
    "observability"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0"
  }
}
