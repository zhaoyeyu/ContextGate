{
  "id": "openclaw-plugin-predictive-gating",
  "name": "Predictive Gating",
  "description": "Explainable, configurable context update policy with safe observation defaults.",
  "version": "0.2.0",
  "kind": "context-engine",
  "activation": {
    "onStartup": true
  },
  "skills": [
    "skills"
  ],
  "contracts": {
    "tools": [
      "predictive_gating_inspect",
      "predictive_gating_record_feedback"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "operationMode": {
        "type": "string",
        "enum": [
          "observe",
          "enforce"
        ],
        "default": "observe",
        "description": "Observe preserves full context while reporting recommendations; enforce may reduce context."
      },
      "contentLogging": {
        "type": "string",
        "enum": [
          "metadata",
          "full"
        ],
        "default": "metadata"
      },
      "allowSensitiveDiagnostics": {
        "type": "boolean",
        "default": false
      },
      "defaultProfile": {
        "type": "string",
        "enum": [
          "workflow_local_delta",
          "coding_iterative",
          "research_global_reinterpretation",
          "safety_critical"
        ],
        "default": "coding_iterative"
      },
      "logPath": {
        "type": "string",
        "description": "Optional JSONL path for per-turn decision records."
      },
      "statePath": {
        "type": "string",
        "description": "Optional JSON state path. Stored state can contain conversation content and must be protected."
      },
      "maxRecentDeltas": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 20
      },
      "maxSessions": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10000,
        "default": 500
      },
      "sessionTtlMinutes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10080,
        "default": 1440
      },
      "preserveRecentMessages": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50,
        "default": 6
      },
      "forceFullRefreshAfterCorrections": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10,
        "default": 2
      },
      "profiles": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "workflow_local_delta": {
            "$ref": "#/$defs/profile"
          },
          "coding_iterative": {
            "$ref": "#/$defs/profile"
          },
          "research_global_reinterpretation": {
            "$ref": "#/$defs/profile"
          },
          "safety_critical": {
            "$ref": "#/$defs/profile"
          }
        }
      }
    },
    "$defs": {
      "profile": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "absorbMaxActionRelevance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "absorbMaxPredictionError": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "injectMaxRiskDelta": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "partialRefreshConflict": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "fullRefreshRisk": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "fullRefreshConflict": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minConfidenceToGate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  },
  "uiHints": {
    "operationMode": {
      "label": "Operation mode",
      "help": "Start in observe mode and validate recommendations before enabling enforcement."
    },
    "contentLogging": {
      "label": "Decision log detail"
    },
    "statePath": {
      "label": "Persistent state path",
      "sensitive": true
    }
  }
}
